<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root_scroll" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingLeft="20dp" android:paddingTop="18dp" android:paddingRight="20dp" android:paddingBottom="28dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:layout_width="34dp" android:layout_height="34dp" android:src="@drawable/ic_clock" android:contentDescription=""/>
            <Space android:layout_width="10dp" android:layout_height="1dp"/>
            <TextView android:id="@+id/app_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="אני פרווה!" android:textColor="@color/text_primary" android:textSize="22sp" android:textStyle="bold"/>
            <ImageButton android:id="@+id/settings_button" android:layout_width="48dp" android:layout_height="48dp" android:background="@android:color/transparent" android:src="@android:drawable/ic_menu_preferences" android:contentDescription="הגדרות" android:tint="#536176"/>
        </LinearLayout>

        <TextView android:id="@+id/question" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="34dp" android:gravity="center" android:text="מה אכלת עכשיו?" android:textColor="@color/text_primary" android:textSize="28sp" android:textStyle="bold"/>
        <TextView android:id="@+id/subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:text="בחר/י והטיימר מתחיל מיד" android:textColor="@color/text_secondary" android:textSize="15sp"/>

        <LinearLayout android:id="@+id/choice_container" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="26dp" android:orientation="horizontal">
            <LinearLayout android:id="@+id/beef_card" android:layout_width="0dp" android:layout_height="190dp" android:layout_weight="1" android:background="@drawable/bg_beef_card" android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="vertical" android:foreground="?android:attr/selectableItemBackground">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🥩" android:textSize="64sp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="בשרי" android:textColor="@color/white" android:textSize="21sp" android:textStyle="bold"/>
                <TextView android:id="@+id/beef_duration" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="6 שעות" android:textColor="#F8DADA" android:textSize="13sp"/>
            </LinearLayout>
            <Space android:layout_width="14dp" android:layout_height="1dp"/>
            <LinearLayout android:id="@+id/dairy_card" android:layout_width="0dp" android:layout_height="190dp" android:layout_weight="1" android:background="@drawable/bg_dairy_card" android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="vertical" android:foreground="?android:attr/selectableItemBackground">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🧀" android:textSize="64sp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="חלבי" android:textColor="@color/white" android:textSize="21sp" android:textStyle="bold"/>
                <TextView android:id="@+id/dairy_duration" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="שעה" android:textColor="#DCEAFF" android:textSize="13sp"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:id="@+id/timer_panel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="26dp" android:background="@drawable/bg_surface" android:gravity="center" android:orientation="vertical" android:paddingTop="24dp" android:paddingBottom="24dp" android:visibility="gone">
            <TextView android:id="@+id/timer_category" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="בשרי" android:textColor="@color/text_secondary" android:textSize="14sp" android:textStyle="bold"/>
            <FrameLayout android:layout_width="238dp" android:layout_height="238dp" android:layout_marginTop="12dp">
                <com.parevetimer.app.ProgressRingView android:id="@+id/progress_ring" android:layout_width="match_parent" android:layout_height="match_parent"/>
                <TextView android:id="@+id/countdown_text" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="06:00:00" android:textColor="@color/text_primary" android:textSize="42sp" android:textStyle="bold" android:fontFamily="monospace"/>
            </FrameLayout>
            <TextView android:id="@+id/progress_percent" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="100% נשארו" android:textColor="@color/text_secondary" android:textSize="14sp"/>
            <TextView android:id="@+id/cancel_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:paddingLeft="18dp" android:paddingTop="10dp" android:paddingRight="18dp" android:paddingBottom="10dp" android:text="ביטול טיימר" android:textColor="@color/beef_dark" android:textSize="14sp" android:textStyle="bold" android:background="@drawable/bg_surface" android:clickable="true" android:focusable="true"/>
        </LinearLayout>

        <LinearLayout android:id="@+id/pareve_panel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="26dp" android:background="@drawable/bg_surface" android:gravity="center" android:orientation="vertical" android:paddingTop="26dp" android:paddingBottom="26dp" android:visibility="gone">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="✓" android:textColor="@color/green" android:textSize="42sp" android:textStyle="bold"/>
            <TextView android:id="@+id/pareve_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="אני פרווה!" android:textColor="@color/green_dark" android:textSize="30sp" android:textStyle="bold"/>
            <TextView android:id="@+id/pareve_subtitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="אפשר להתחיל מחדש בכל רגע" android:textColor="@color/text_secondary" android:textSize="14sp"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
