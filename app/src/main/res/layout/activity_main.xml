<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_scroll" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bg" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingStart="16dp" android:paddingTop="14dp"
        android:paddingEnd="16dp" android:paddingBottom="24dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <ImageView android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_app_icon" android:contentDescription=""/>
            <TextView android:id="@+id/app_title" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginStart="8dp" android:text="אני פרווה!"
                android:textColor="@color/text_primary" android:textSize="21sp" android:textStyle="bold"/>
            <ImageButton android:id="@+id/settings_button" android:layout_width="44dp" android:layout_height="44dp"
                android:background="@android:color/transparent" android:src="@android:drawable/ic_menu_preferences"
                android:contentDescription="הגדרות" android:tint="#536176"/>
        </LinearLayout>

        <TextView android:id="@+id/question" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" android:gravity="center" android:text="מה אכלת עכשיו?"
            android:textColor="@color/text_primary" android:textSize="25sp" android:textStyle="bold"/>
        <TextView android:id="@+id/subtitle" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="5dp" android:gravity="center" android:text="בחר והטיימר מתחיל מיד"
            android:textColor="@color/text_secondary" android:textSize="14sp"/>

        <LinearLayout android:id="@+id/choice_container" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" android:orientation="vertical">
            <LinearLayout android:id="@+id/beef_card" android:layout_width="match_parent" android:layout_height="132dp"
                android:background="@drawable/bg_beef_card" android:clickable="true" android:focusable="true"
                android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="22dp"
                android:paddingEnd="22dp" android:foreground="?android:attr/selectableItemBackground">
                <TextView android:layout_width="70dp" android:layout_height="wrap_content" android:gravity="center"
                    android:text="🥩" android:textSize="48sp"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:orientation="vertical" android:paddingStart="12dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="בשרי"
                        android:textColor="@color/white" android:textSize="21sp" android:textStyle="bold"/>
                    <TextView android:id="@+id/beef_duration" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="4dp" android:text="6 שעות" android:textColor="#F8DADA" android:textSize="13sp"/>
                </LinearLayout>
            </LinearLayout>

            <Space android:layout_width="1dp" android:layout_height="12dp"/>
            <LinearLayout android:id="@+id/dairy_card" android:layout_width="match_parent" android:layout_height="132dp"
                android:background="@drawable/bg_dairy_card" android:clickable="true" android:focusable="true"
                android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="22dp"
                android:paddingEnd="22dp" android:foreground="?android:attr/selectableItemBackground">
                <TextView android:layout_width="70dp" android:layout_height="wrap_content" android:gravity="center"
                    android:text="🧀" android:textSize="48sp"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:orientation="vertical" android:paddingStart="12dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="חלבי"
                        android:textColor="@color/white" android:textSize="21sp" android:textStyle="bold"/>
                    <TextView android:id="@+id/dairy_duration" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="4dp" android:text="שעה" android:textColor="#DCEAFF" android:textSize="13sp"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:id="@+id/timer_panel" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" android:background="@drawable/bg_surface" android:gravity="center"
            android:orientation="vertical" android:paddingTop="16dp" android:paddingBottom="18dp" android:visibility="gone">
            <TextView android:id="@+id/timer_category" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="בשרי" android:textColor="@color/text_secondary" android:textSize="14sp" android:textStyle="bold"/>
            <FrameLayout android:layout_width="220dp" android:layout_height="220dp" android:layout_marginTop="7dp">
                <com.parevetimer.app.ProgressRingView android:id="@+id/progress_ring" android:layout_width="match_parent" android:layout_height="match_parent"/>
                <TextView android:id="@+id/countdown_text" android:layout_width="match_parent" android:layout_height="match_parent"
                    android:gravity="center" android:includeFontPadding="false" android:text="06:00:00"
                    android:textColor="@color/text_primary" android:textSize="31sp" android:textStyle="bold" android:fontFamily="monospace"/>
            </FrameLayout>
            <TextView android:id="@+id/progress_percent" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="1dp" android:text="100% נשארו" android:textColor="@color/text_secondary" android:textSize="13sp"/>
            <TextView android:id="@+id/cancel_text" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:paddingStart="18dp" android:paddingTop="9dp" android:paddingEnd="18dp"
                android:paddingBottom="9dp" android:text="ביטול טיימר" android:textColor="@color/beef_dark"
                android:textSize="14sp" android:textStyle="bold" android:background="@drawable/bg_surface"
                android:clickable="true" android:focusable="true"/>
        </LinearLayout>

        <LinearLayout android:id="@+id/pareve_panel" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" android:background="@drawable/bg_surface" android:gravity="center"
            android:orientation="vertical" android:paddingTop="20dp" android:paddingBottom="20dp" android:visibility="gone">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="✓"
                android:textColor="@color/green" android:textSize="36sp" android:textStyle="bold"/>
            <TextView android:id="@+id/pareve_text" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:text="אני פרווה!" android:textColor="@color/green_dark"
                android:textSize="27sp" android:textStyle="bold"/>
            <TextView android:id="@+id/pareve_subtitle" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:text="אפשר להתחיל מחדש בכל רגע" android:textColor="@color/text_secondary" android:textSize="13sp"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>