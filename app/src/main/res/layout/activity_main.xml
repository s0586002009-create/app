<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_scroll" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bg" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingStart="16dp" android:paddingTop="14dp"
        android:paddingEnd="16dp" android:paddingBottom="24dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical">
            <ImageView android:layout_width="34dp" android:layout_height="34dp"
                android:src="@drawable/ic_app_icon" android:contentDescription=""/>
            <TextView android:id="@+id/app_title" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginStart="8dp" android:text="אני פרווה!"
                android:textColor="@color/text_primary" android:textSize="21sp" android:textStyle="bold"/>
            <ImageButton android:id="@+id/settings_button" android:layout_width="46dp" android:layout_height="46dp"
                android:background="@android:color/transparent" android:src="@drawable/ic_settings"
                android:contentDescription="הגדרות"/>
        </LinearLayout>

        <TextView android:id="@+id/question" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" android:gravity="center" android:text="מה אכלת עכשיו?"
            android:textColor="@color/text_primary" android:textSize="25sp" android:textStyle="bold"/>
        <TextView android:id="@+id/subtitle" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="5dp" android:gravity="center" android:text="בחר והטיימר מתחיל מיד"
            android:textColor="@color/text_secondary" android:textSize="14sp"/>

        <LinearLayout android:id="@+id/choice_container" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" android:orientation="vertical">

            <LinearLayout android:id="@+id/beef_card" android:layout_width="match_parent" android:layout_height="132dp"
                android:background="@drawable/bg_beef_card" android:clickable="true" android:focusable="true"
                android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="18dp"
                android:paddingEnd="18dp" android:foreground="?android:attr/selectableItemBackground">
                <TextView android:layout_width="64dp" android:layout_height="wrap_content" android:gravity="center"
                    android:text="🥩" android:textSize="45sp"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:orientation="vertical" android:paddingStart="10dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="בשרי"
                        android:textColor="@color/white" android:textSize="21sp" android:textStyle="bold"/>
                    <TextView android:id="@+id/beef_duration" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="4dp" android:text="6 שעות" android:textColor="#F8DADA" android:textSize="13sp"/>
                </LinearLayout>
            </LinearLayout>

            <Space android:layout_width="1dp" android:layout_height="12dp"/>

            <LinearLayout android:id="@+id/dairy_card" android:layout_width="match_parent" android:layout_height="132dp"
                android:background="@drawable/bg_dairy_card" android:clickable="true" android:focusable="true"
                android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="18dp"
                android:paddingEnd="18dp" android:foreground="?android:attr/selectableItemBackground">
                <TextView android:layout_width="64dp" android:layout_height="wrap_content" android:gravity="center"
                    android:text="🧀" android:textSize="45sp"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:orientation="vertical" android:paddingStart="10dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="חלבי"
                        android:textColor="@color/white" android:textSize="21sp" android:textStyle="bold"/>
                    <TextView android:id="@+id/dairy_duration" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="4dp" android:text="6 שעות" android:textColor="#DCEAFF" android:textSize="13sp"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>