<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingLeft="20dp" android:paddingTop="22dp" android:paddingRight="20dp" android:paddingBottom="32dp">
        <TextView android:id="@+id/settings_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="הגדרות" android:textColor="@color/text_primary" android:textSize="28sp" android:textStyle="bold"/>
        <TextView android:id="@+id/settings_intro" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:text="הגדירו את זמני ההמתנה שנוחים לכם" android:textColor="@color/text_secondary" android:textSize="15sp"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:background="@drawable/bg_surface" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="זמן המתנה" android:textColor="@color/text_primary" android:textSize="18sp" android:textStyle="bold"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="אפשר לבחור כל משך זמן. גם שעות וגם דקות." android:textColor="@color/text_secondary" android:textSize="13sp"/>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="בשרי" android:textColor="@color/beef_dark" android:textSize="16sp" android:textStyle="bold"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
                <EditText android:id="@+id/beef_hours" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:background="@drawable/bg_surface" android:gravity="center" android:hint="6" android:inputType="number" android:maxLength="2" android:textColor="@color/text_primary" android:textSize="19sp"/>
                <TextView android:layout_width="50dp" android:layout_height="56dp" android:gravity="center" android:text="שעות" android:textColor="@color/text_secondary" android:textSize="13sp"/>
                <EditText android:id="@+id/beef_minutes" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:background="@drawable/bg_surface" android:gravity="center" android:hint="0" android:inputType="number" android:maxLength="2" android:textColor="@color/text_primary" android:textSize="19sp"/>
                <TextView android:layout_width="56dp" android:layout_height="56dp" android:gravity="center" android:text="דק׳" android:textColor="@color/text_secondary" android:textSize="13sp"/>
            </LinearLayout>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="חלבי" android:textColor="@color/dairy_dark" android:textSize="16sp" android:textStyle="bold"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
                <EditText android:id="@+id/dairy_hours" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:background="@drawable/bg_surface" android:gravity="center" android:hint="1" android:inputType="number" android:maxLength="2" android:textColor="@color/text_primary" android:textSize="19sp"/>
                <TextView android:layout_width="50dp" android:layout_height="56dp" android:gravity="center" android:text="שעות" android:textColor="@color/text_secondary" android:textSize="13sp"/>
                <EditText android:id="@+id/dairy_minutes" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:background="@drawable/bg_surface" android:gravity="center" android:hint="0" android:inputType="number" android:maxLength="2" android:textColor="@color/text_primary" android:textSize="19sp"/>
                <TextView android:layout_width="56dp" android:layout_height="56dp" android:gravity="center" android:text="דק׳" android:textColor="@color/text_secondary" android:textSize="13sp"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:background="@drawable/bg_surface" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="התראה בסיום" android:textColor="@color/text_primary" android:textSize="18sp" android:textStyle="bold"/>
            <RadioGroup android:id="@+id/notification_group" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp">
                <RadioButton android:id="@+id/radio_system" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="צליל מערכת" android:textColor="@color/text_primary" android:textSize="15sp"/>
                <RadioButton android:id="@+id/radio_vibrate" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="רטט / שקט" android:textColor="@color/text_primary" android:textSize="15sp"/>
                <RadioButton android:id="@+id/radio_custom1" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="מנגינה: פעמון עדין" android:textColor="@color/text_primary" android:textSize="15sp"/>
                <RadioButton android:id="@+id/radio_custom2" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="מנגינה: צליל קצר" android:textColor="@color/text_primary" android:textSize="15sp"/>
            </RadioGroup>
        </LinearLayout>

        <Button android:id="@+id/save_button" android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginTop="20dp" android:backgroundTint="#315FAE" android:text="שמור הגדרות" android:textColor="@color/white" android:textSize="16sp" android:textStyle="bold"/>
    </LinearLayout>
</ScrollView>
