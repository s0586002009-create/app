<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bg" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:gravity="center_horizontal" android:orientation="vertical"
        android:paddingStart="18dp" android:paddingTop="18dp" android:paddingEnd="18dp" android:paddingBottom="24dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="הטיימר שלי"
                android:textColor="@color/text_primary" android:textSize="22sp" android:textStyle="bold"/>
            <ImageButton android:id="@+id/home_button" android:layout_width="46dp" android:layout_height="46dp"
                android:background="@android:color/transparent" android:src="@android:drawable/ic_menu_revert"
                android:contentDescription="חזור למסך הבית" android:tint="@color/text_secondary"/>
        </LinearLayout>

        <TextView android:id="@+id/timer_category" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="בשרי" android:textColor="@color/text_secondary"
            android:textSize="17sp" android:textStyle="bold"/>

        <FrameLayout android:layout_width="min(82%, 280dp)" android:layout_height="min(82%, 280dp)"
            android:layout_marginTop="10dp" android:layout_gravity="center">
            <com.parevetimer.app.ProgressRingView android:id="@+id/progress_ring"
                android:layout_width="match_parent" android:layout_height="match_parent"/>
            <TextView android:id="@+id/countdown_text" android:layout_width="match_parent"
                android:layout_height="match_parent" android:gravity="center" android:includeFontPadding="false"
                android:text="06:00:00" android:textColor="@color/text_primary" android:textSize="31sp"
                android:textStyle="bold" android:fontFamily="monospace"/>
        </FrameLayout>

        <TextView android:id="@+id/progress_percent" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:text="100% נשארו" android:textColor="@color/text_secondary" android:textSize="14sp"/>

        <TextView android:id="@+id/finished_text" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" android:gravity="center" android:text="הטיימר הסתיים"
            android:textColor="@color/green_dark" android:textSize="20sp" android:textStyle="bold"
            android:visibility="gone"/>

        <Button android:id="@+id/cancel_button" android:layout_width="match_parent" android:layout_height="54dp"
            android:layout_marginTop="18dp" android:backgroundTint="@color/beef_dark"
            android:text="בטל טיימר" android:textColor="@color/white" android:textSize="16sp"
            android:textStyle="bold"/>

        <Button android:id="@+id/home_button_bottom" android:layout_width="match_parent" android:layout_height="54dp"
            android:layout_marginTop="10dp" android:backgroundTint="@color/dairy_dark"
            android:text="חזור למסך הבית" android:textColor="@color/white" android:textSize="16sp"
            android:textStyle="bold" android:visibility="gone"/>
    </LinearLayout>
</ScrollView>