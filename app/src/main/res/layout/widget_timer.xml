<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/bg_surface" android:gravity="center_vertical" android:orientation="vertical" android:padding="10dp">
    <LinearLayout android:id="@+id/widget_open" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical">
        <TextView android:id="@+id/widget_title" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="אני פרווה!" android:textColor="@color/text_primary"
            android:textSize="15sp" android:textStyle="bold"/>
        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_app_icon" android:contentDescription=""/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp">
        <TextView android:id="@+id/widget_beef" android:layout_width="0dp" android:layout_height="42dp"
            android:layout_weight="1" android:background="@drawable/bg_beef_card" android:gravity="center"
            android:text="🥩  בשרי" android:textColor="@color/white" android:textSize="13sp" android:textStyle="bold"/>
        <Space android:layout_width="7dp" android:layout_height="1dp"/>
        <TextView android:id="@+id/widget_dairy" android:layout_width="0dp" android:layout_height="42dp"
            android:layout_weight="1" android:background="@drawable/bg_dairy_card" android:gravity="center"
            android:text="🧀  חלבי" android:textColor="@color/white" android:textSize="13sp" android:textStyle="bold"/>
    </LinearLayout>
    <Chronometer android:id="@+id/widget_chronometer" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="5dp" android:gravity="center" android:textColor="@color/text_primary"
        android:textSize="18sp" android:textStyle="bold" android:countDown="true" android:visibility="gone"/>
    <TextView android:id="@+id/widget_status" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="5dp" android:gravity="center" android:text="מוכן להתחלה"
        android:textColor="@color/green_dark" android:textSize="14sp" android:textStyle="bold"/>
</LinearLayout>